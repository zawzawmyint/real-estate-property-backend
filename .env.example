NODE_ENV=development
HOST=127.0.0.1
PORT=4311
LOG_LEVEL=info
DATABASE_URL=file:./var/data/development.db
STORAGE_ROOT=./var/uploads
PUBLIC_ORIGIN=http://localhost:4311

APP_ORIGIN=http://localhost:3100
BETTER_AUTH_URL=http://localhost:3100/api/v1/auth
# Server only: replace with an independently generated random secret (at least 32 characters).
BETTER_AUTH_SECRET=REPLACE_WITH_YOUR_RANDOM_SERVER_SECRET

# Shared with the frontend server only. Independently generate at least 32 random characters.
# Required in production. Never prefix with NEXT_PUBLIC_ or expose it to clients.
INQUIRY_RELAY_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SERVER_SECRET

# Public property chatbot demo. Supply a server-only key and build the FAQ index before enabling.
PUBLIC_CHAT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
PUBLIC_CHAT_INDEX_PATH=./var/public-chat/faq-index.json
PUBLIC_CHAT_UPSTREAM_CALLS_PER_DAY=45

# Transactional email groups. Disabled groups record no new email work.
# Configure a monitored reply-to and an authorized sender before activation.
EMAIL_ENQUIRY_NOTIFICATIONS_ENABLED=false
EMAIL_STAFF_NOTIFICATIONS_ENABLED=false
EMAIL_CUSTOMER_VIEWING_NOTIFICATIONS_ENABLED=false
# Required when customer viewing emails are enabled; UTC cutoff stays fixed across restarts.
EMAIL_CUSTOMER_VIEWING_ACTIVATED_AT=
EMAIL_BRAND_NAME=Avenor
SMTP_REPLY_TO=
# JSON key ID -> independently generated 32-byte base64 encryption key; retain old keys during rotation.
# Use a single-quoted JSON object, for example:
# EMAIL_PAYLOAD_KEYS='{"local-v1":"REPLACE_WITH_32_BYTE_BASE64_KEY"}'
EMAIL_PAYLOAD_KEYS=
EMAIL_PAYLOAD_ACTIVE_KEY_ID=
# Worker only. Use a unique deployment prefix; production requires authenticated rediss: TLS.
REDIS_URL=
EMAIL_QUEUE_PREFIX=avenor-email-local
EMAIL_CONCURRENCY=2
# Allocate this budget across ALL applications sharing the SMTP account; no production default.
EMAIL_RATE_LIMIT_MAX=
EMAIL_RATE_LIMIT_DURATION_MS=1000
EMAIL_WORKER_HEALTH_PORT=4312
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
