{
  "name": "real-estate-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "db:generate": "prisma generate",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts",
    "demo:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-properties.ts",
    "staff": "node --env-file-if-exists=.env --import tsx scripts/staff.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-database.ts",
    "test:auth:e2e-server": "node --import tsx scripts/auth-e2e-server.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
