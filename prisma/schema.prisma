generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Better Auth 1.7.12 core + Admin plugin schema, reviewed against installed getAuthTables.
model User {
  id                String         @id
  name              String
  searchName        String         @default("")
  email             String         @unique
  emailVerified     Boolean        @default(false)
  image             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  role              String         @default("agent")
  disabled          Boolean        @default(false)
  credentialVersion Int            @default(0)
  banned            Boolean?       @default(false)
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]
  accounts          Account[]
  assignedLeads     Lead[]         @relation("LeadAssignee")
  createdLeads      Lead[]         @relation("LeadCreator")
  leadNotes         LeadNote[]
  leadActivities    LeadActivity[]
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String   @unique
  credentialVersion Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  impersonatedBy    String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Property {
  id              String          @id @default(uuid())
  demoKey         String?         @unique
  isDemo          Boolean         @default(false)
  title           String
  purpose         String
  type            String?
  description     String?
  priceFils       BigInt?
  city            String?
  community       String?
  searchTitle     String          @default("")
  searchCity      String          @default("")
  searchCommunity String          @default("")
  bedrooms        Int?
  bathrooms       Int?
  areaHundredths  Int?
  ownerName       String?
  ownerPhone      String?
  publishingState String          @default("draft")
  availability    String          @default("available")
  featured        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  photos          PropertyPhoto[]
  leads           Lead[]

  @@index([publishingState, availability, createdAt])
  @@index([purpose, type, city])
  @@index([updatedAt])
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  propertyId String
  storageKey String   @unique
  position   Int
  width      Int
  height     Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
}

model Lead {
  id                        String                  @id @default(uuid())
  name                      String
  phone                     String?
  email                     String?
  searchName                String
  searchPhone               String
  searchEmail               String
  searchPropertyTitle       String
  purpose                   String
  budgetFils                BigInt?
  source                    String
  stage                     String                  @default("new")
  propertyId                String?
  property                  Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyTitleSnapshot     String?
  propertyLocationSnapshot  String?
  assignedAgentId           String?
  assignedAgent             User?                   @relation("LeadAssignee", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAgentNameSnapshot String?
  createdById               String?
  createdBy                 User?                   @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  originalMessage           String?
  version                   Int                     @default(1)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  notes                     LeadNote[]
  activities                LeadActivity[]
  receipts                  LeadSubmissionReceipt[]

  @@index([assignedAgentId, createdAt, id])
  @@index([assignedAgentId, stage, createdAt])
  @@index([source, createdAt])
  @@index([updatedAt, id])
  @@index([propertyId])
}

model LeadNote {
  id                 String                  @id @default(uuid())
  leadId             String
  lead               Lead                    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  authorId           String?
  author             User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorNameSnapshot String
  kind               String
  body               String
  createdAt          DateTime                @default(now())
  activity           LeadActivity?
  receipts           LeadSubmissionReceipt[]

  @@index([leadId, createdAt, id])
}

model LeadActivity {
  id                String    @id @default(uuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actorId           String?
  actor             User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorNameSnapshot String?
  type              String
  noteId            String?   @unique
  note              LeadNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)
  previousStage     String?
  nextStage         String?
  previousAgentId   String?
  previousAgentName String?
  nextAgentId       String?
  nextAgentName     String?
  changedFields     String    @default("[]")
  createdAt         DateTime  @default(now())

  @@index([leadId, createdAt, id])
}

model LeadSubmissionReceipt {
  id          String    @id
  operation   String
  actorScope  String
  payloadHash String
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  noteId      String?
  note        LeadNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
}
